# Mobile App Environment Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourMobileFirebaseApiKey
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=safeguard-prod-demo.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://safeguard-prod-demo-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=safeguard-prod-demo
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=safeguard-prod-demo.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:android:abcdef123456

# Backend Server IP / URL (Use your machine's LAN IP for physical device testing e.g. http://192.168.1.100:5000, or http://10.0.2.2:5000 for Android Emulator)
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:5000

# Google Maps API Key for Mobile
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourMobileGoogleMapsKey
