# SafeGuard Server Environment Configuration
PORT=5000

# Firebase Configuration
# If serviceAccountKey.json is present in server/, it will be loaded automatically.
# Otherwise, set these properties:
FIREBASE_PROJECT_ID=safeguard-prod-demo
FIREBASE_DATABASE_URL=https://safeguard-prod-demo-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=safeguard-prod-demo.appspot.com

# Geofire Radius Configurations (in meters)
DEFAULT_NEARBY_RADIUS_METERS=1000
ESCALATED_NEARBY_RADIUS_METERS=2500

# Google Maps API (Optional server-side reverse geocoding)
GOOGLE_MAPS_API_KEY=AIzaSyYourServerGoogleMapsKeyHere
